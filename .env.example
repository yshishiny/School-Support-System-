# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://zjmswphiqmsnkhngepvv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API, used to turn WhatsApp exports into homework/quiz/exam items
ANTHROPIC_API_KEY=
# Cost tier: saver (default; routine jobs on Haiku 4.5), balanced (Sonnet), best (everything on Opus).
# The coach report, clinician summary and confidential chat always run on Opus.
AI_TIER=saver

# Protects the daily report cron endpoint (Vercel sends it as a Bearer token)
CRON_SECRET=

# Telegram delivery for the daily parent report (recommended: official API, reliable).
# Create a bot with @BotFather, paste its token, and set the bot's username so Settings can show it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# WhatsApp delivery for the daily parent report (optional alongside Telegram).
# Options: callmebot (simplest, personal), meta (WhatsApp Cloud API), or leave empty
# to only store the report in the dashboard.
WHATSAPP_PROVIDER=
CALLMEBOT_API_KEY=
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=

# Domain appended to child usernames to form their login email (no real mail is sent)
CHILD_LOGIN_DOMAIN=study.local

# Browser notifications (Web Push). Generate once with: npx web-push generate-vapid-keys
# The public key is also exposed to the browser as NEXT_PUBLIC_VAPID_PUBLIC_KEY (same value).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Public URL used in reminder texts
NEXT_PUBLIC_APP_URL=https://school-support-system.vercel.app

# Optional: YouTube Data API v3 key (Google Cloud console, free quota). With it, each topic's "Watch it" section embeds
# real videos from Khan Academy, CrashCourse, Nafham and the rest; without it, the child gets a search link per channel.
YOUTUBE_API_KEY=

# Optional, Admin page (More → Admin): show deployments, commits and project status.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
GITHUB_TOKEN=
GITHUB_REPO=yshishiny/School-Support-System-
SUPABASE_ACCESS_TOKEN=

# Android app (Trusted Web Activity): set after packaging with PWABuilder, see docs/ANDROID.md
ANDROID_PACKAGE=
ANDROID_SHA256=

# Beta deployment sharing the live database: set to 1 so the nightly and evening crons run only on production.
CRON_DISABLED=

# Optional, V2 teachers: premium voices (Microsoft Azure Speech; the one service with real Egyptian Arabic voices).
# Azure portal → create a "Speech" resource (free tier F0: 500,000 characters a month) → Keys and Endpoint.
# Region is the short id, e.g. westeurope, uaenorth, eastus. Without these the lesson uses the phone's own voices.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional, V2 teachers: video presenters (D-ID). Each scripted line becomes a clip of a human presenter speaking with
# the premium voice; clips are rendered once and kept. D-ID Studio → API key (paste as given). Cap under Admin → Teachers.
DID_API_KEY=
