# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://zjmswphiqmsnkhngepvv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API, used to turn WhatsApp exports into homework/quiz/exam items
ANTHROPIC_API_KEY=
# Cost tier: saver (default; routine jobs on Haiku 4.5), balanced (Sonnet), best (everything on Opus).
# The coach report, clinician summary and confidential chat always run on Opus.
AI_TIER=saver

# Protects the daily report cron endpoint (Vercel sends it as a Bearer token)
CRON_SECRET=

# Telegram delivery for the daily parent report (recommended: official API, reliable).
# Create a bot with @BotFather, paste its token, and set the bot's username so Settings can show it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# WhatsApp delivery for the daily parent report (optional alongside Telegram).
# Options: callmebot (simplest, personal), meta (WhatsApp Cloud API), or leave empty
# to only store the report in the dashboard.
WHATSAPP_PROVIDER=
CALLMEBOT_API_KEY=
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=

# Domain appended to child usernames to form their login email (no real mail is sent)
CHILD_LOGIN_DOMAIN=study.local
